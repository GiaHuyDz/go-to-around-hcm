{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Go to around HCM places",
  "description": "A place is a verified record or an explicitly marked research candidate. Null means the value has not been verified or sourced.",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "allOf": [
      {
        "if": {
          "properties": {
            "address": {
              "type": "string"
            }
          },
          "required": ["address"]
        },
        "then": {
          "properties": {
            "sourceUrl": {
              "type": "string",
              "format": "uri"
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "image": {
              "type": "string"
            }
          },
          "required": ["image"]
        },
        "then": {
          "required": ["imageAlt", "imageCreator", "imageLicenseUrl"]
        }
      }
    ],
    "required": [
      "id",
      "name",
      "category",
      "description",
      "address",
      "latitude",
      "longitude",
      "coordinateSourceUrl",
      "image",
      "imageSource",
      "imageLicense",
      "sourceUrl",
      "lastVerified",
      "openingHours",
      "ticketInfo",
      "visitorInfoVerified",
      "hasPanorama",
      "panoramaSource",
      "panoramaLicense",
      "tags",
      "featured",
      "verificationStatus",
      "verificationNotes"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "name": {
        "type": "string",
        "minLength": 1
      },
      "category": {
        "enum": [
          "historical-site",
          "market",
          "architecture",
          "museum",
          "public-space",
          "performing-arts",
          "nature",
          "shopping",
          "cultural-area",
          "food"
        ]
      },
      "description": {
        "type": ["string", "null"]
      },
      "address": {
        "type": ["string", "null"]
      },
      "latitude": {
        "type": ["number", "null"],
        "minimum": -90,
        "maximum": 90
      },
      "longitude": {
        "type": ["number", "null"],
        "minimum": -180,
        "maximum": 180
      },
      "coordinateSourceUrl": {
        "type": ["string", "null"],
        "format": "uri"
      },
      "image": {
        "type": ["string", "null"],
        "format": "uri-reference"
      },
      "imageAlt": {
        "type": ["string", "null"],
        "minLength": 1
      },
      "imageCreator": {
        "type": ["string", "null"],
        "minLength": 1
      },
      "imageLicenseUrl": {
        "type": ["string", "null"],
        "format": "uri"
      },
      "imageSource": {
        "type": ["string", "null"],
        "format": "uri"
      },
      "imageLicense": {
        "type": ["string", "null"]
      },
      "sourceUrl": {
        "type": ["string", "null"],
        "format": "uri"
      },
      "lastVerified": {
        "type": ["string", "null"],
        "format": "date"
      },
      "openingHours": {
        "type": ["string", "null"]
      },
      "ticketInfo": {
        "type": ["string", "null"]
      },
      "visitorInfoVerified": {
        "type": "boolean"
      },
      "hasPanorama": {
        "type": "boolean"
      },
      "panoramaSource": {
        "type": ["string", "null"],
        "format": "uri"
      },
      "panoramaLicense": {
        "type": ["string", "null"]
      },
      "tags": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "uniqueItems": true
      },
      "featured": {
        "type": "boolean"
      },
      "verificationStatus": {
        "enum": ["candidate", "partially-verified", "verified"]
      },
      "verificationNotes": {
        "type": "string"
      }
    }
  }
}

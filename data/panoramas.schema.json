{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Go to around HCM panoramas",
  "description": "Independently sourced 360-degree panoramas; a panorama is not associated with a venue unless its location is verified.",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "placeId",
      "title",
      "description",
      "type",
      "imageUrl",
      "sourceUrl",
      "licenseName",
      "licenseUrl",
      "creator",
      "creatorUrl",
      "capturedAt",
      "latitude",
      "longitude",
      "width",
      "height"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "placeId": {
        "type": ["string", "null"],
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "title": {
        "type": "string",
        "minLength": 1
      },
      "description": {
        "type": "string",
        "minLength": 1
      },
      "type": {
        "const": "equirectangular"
      },
      "imageUrl": {
        "type": "string",
        "format": "uri"
      },
      "sourceUrl": {
        "type": "string",
        "format": "uri"
      },
      "licenseName": {
        "type": "string",
        "minLength": 1
      },
      "licenseUrl": {
        "type": "string",
        "format": "uri"
      },
      "creator": {
        "type": "string",
        "minLength": 1
      },
      "creatorUrl": {
        "type": "string",
        "format": "uri"
      },
      "capturedAt": {
        "type": "string",
        "format": "date-time"
      },
      "latitude": {
        "type": "number",
        "minimum": -90,
        "maximum": 90
      },
      "longitude": {
        "type": "number",
        "minimum": -180,
        "maximum": 180
      },
      "width": {
        "type": "integer",
        "minimum": 1
      },
      "height": {
        "type": "integer",
        "minimum": 1
      }
    }
  }
}
